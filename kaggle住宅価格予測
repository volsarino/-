        "class KaggleHouse:\n",
        "    def __init__(self, batch_size, train_df=None, val_df=None):\n",
        "        self.batch_size = batch_size\n",
        "        if train_df is not None:\n",
        "            self.train = train_df.copy()\n",
        "            self.val = val_df.copy() if val_df is not None else None\n",
        "        else:\n",
        "            try:\n",
        "                self.raw_train = pd.read_csv('train.csv')\n",
        "                self.raw_val = pd.read_csv('test.csv')  # Kaggleの本番テストデータ\n",
        "            except FileNotFoundError:\n",
        "                raise FileNotFoundError(\"エラー: 'train.csv' または 'test.csv' が見つかりません。スクリプトと同じフォルダに配置してください。\")\n",
        "            self.train = None\n",
        "            self.val = None\n",
        "\n",
        "    def preprocess(self):\n",
        "        if self.train is not None:\n",
        "            return\n",
        "\n",
        "        label = 'SalePrice'\n",
        "        self.raw_train = self.raw_train.drop(\n",
        "            self.raw_train[\n",
        "                (self.raw_train[\"GrLivArea\"] > 4000)\n",
        "                & (self.raw_train[\"SalePrice\"] < 300000)\n",
        "            ].index\n",
        "        ).reset_index(drop=True)\n",
        "\n",
        "        neighborhood_price_map = np.log1p(\n",
        "            self.raw_train.groupby(\"Neighborhood\")[\"SalePrice\"].median()\n",
        "        ).to_dict()\n",
        "\n",
        "        features = pd.concat(\n",
        "            (\n",
        "                self.raw_train.drop(columns=[\"Id\", label]),\n",
        "                self.raw_val.drop(columns=[\"Id\"]),\n",
        "            ),\n",
        "            ignore_index=True,\n",
        "        )\n",
        "\n",
        "        features[\"Neighborhood_LogPrice_Median\"] = features[\"Neighborhood\"].map(\n",
        "            neighborhood_price_map\n",
        "        )\n",
        "\n",
        "        #総合評価とコンディション\n",
        "        features[\"OverallQual_Cond\"] = (\n",
        "            features.get(\"OverallQual\", 0) * features.get(\"OverallCond\", 0)\n",
        "        )\n",
        "\n",
        "        #面積の統合\n",
        "        features[\"TotalSF\"] = (\n",
        "            features.get(\"1stFlrSF\", 0)\n",
        "            + features.get(\"2ndFlrSF\", 0)\n",
        "            + features.get(\"TotalBsmtSF\", 0)\n",
        "        )\n",
        "\n",
        "        enclosed_porch = features.get(\n",
        "            \"EnclosedPorch\", features.get(\"EnclosedPorchSF\", 0)\n",
        "        )\n",
        "        features[\"Total_Porch_SF\"] = (\n",
        "            features.get(\"OpenPorchSF\", 0)\n",
        "            + enclosed_porch\n",
        "            + features.get(\"3SsnPorch\", 0)\n",
        "            + features.get(\"ScreenPorch\", 0)\n",
        "        )\n",
        "\n",
        "        #水回りの合計\n",
        "        features[\"Total_Bathrooms\"] = (\n",
        "            features.get(\"FullBath\", 0)\n",
        "            + (0.5 * features.get(\"HalfBath\", 0))\n",
        "            + features.get(\"BsmtFullBath\", 0)\n",
        "            + (0.5 * features.get(\"BsmtHalfBath\", 0))\n",
        "        )\n",
        "\n",
        "        #年数系\n",
        "        features[\"AgeAtSale\"] = features.get(\"YrSold\", 0) - features.get(\n",
        "            \"YearBuilt\", 0\n",
        "        )\n",
        "        features[\"YearsSinceRemodel\"] = features.get(\n",
        "            \"YrSold\", 0\n",
        "        ) - features.get(\"YearRemodAdd\", 0)\n",
        "\n",
        "        #各設備の有無\n",
        "        features[\"HasPool\"] = (features.get(\"PoolArea\", 0) > 0).astype(\n",
        "            np.float32\n",
        "        )\n",
        "        features[\"HasGarage\"] = (features.get(\"GarageArea\", 0) > 0).astype(\n",
        "            np.float32\n",
        "        )\n",
        "        features[\"HasBsmt\"] = (features.get(\"TotalBsmtSF\", 0) > 0).astype(\n",
        "            np.float32\n",
        "        )\n",
        "        features[\"HasFireplace\"] = (features.get(\"Fireplaces\", 0) > 0).astype(\n",
        "            np.float32\n",
        "        )\n",
        "        #数値データの標準化\n",
        "        numeric_features = features.dtypes[features.dtypes != \"object\"].index\n",
        "\n",
        "        skewed_feats = features[numeric_features].apply(lambda x: skew(x.dropna())).sort_values(ascending=False)\n",
        "        high_skew = skewed_feats[abs(skewed_feats) > 0.75].index\n",
        "\n",
        "        features[high_skew] = np.log1p(features[high_skew])\n",
        "        features[numeric_features] = features[numeric_features].fillna(0)\n",
        "        features[numeric_features] = features[numeric_features].apply(\n",
        "            lambda x: (x - x.mean()) / (x.std() if x.std() > 0 else 1)\n",
        "        )\n",
        "\n",
        "        categorical_features = features.select_dtypes(\n",
        "            include=[\"object\", \"category\"]\n",
        "        ).columns.tolist()\n",
        "        features = pd.get_dummies(\n",
        "            features, columns=categorical_features, dummy_na=True, dtype=float\n",
        "        )\n",
        "        features = features.fillna(0).astype(np.float32)\n",
        "        n_train = self.raw_train.shape[0]\n",
        "        self.train = features.iloc[:n_train, :].copy()\n",
        "        self.train[label] = self.raw_train[label].values\n",
        "        self.val = features.iloc[n_train:, :].copy()\n",
        "\n",
        "    def get_dataloader(self, train):\n",
        "        label = 'SalePrice'\n",
        "\n",
        "        if train:\n",
        "            # 訓練・検証\n",
        "            data = self.train\n",
        "            X = data.drop(columns=[label]).values\n",
        "            y = data[label].values\n",
        "\n",
        "            dataset = HouseTensorDataset(X, y)\n",
        "            return DataLoader(dataset, batch_size=self.batch_size, shuffle=True)\n",
        "        else:\n",
        "            # Kaggle本番予測用\n",
        "            data = self.val\n",
        "            X = data.values\n",
        "\n",
        "            dataset = HouseTensorDataset(X, None)\n",
        "            return DataLoader(dataset, batch_size=self.batch_size, shuffle=False)"
