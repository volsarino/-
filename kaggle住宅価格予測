        "class ResBlock(nn.Module):\n",
        "\n",
        "    def __init__(self, dim, dropout_rate):\n",
        "        super().__init__()\n",
        "        self.block = nn.Sequential(\n",
        "            nn.Linear(dim, dim),\n",
        "            nn.BatchNorm1d(dim),\n",
        "            nn.Mish(),\n",
        "            nn.Dropout(dropout_rate),\n",
        "            nn.Linear(dim, dim),\n",
        "            nn.BatchNorm1d(dim),\n",
        "        )\n",
        "        self.act = nn.Mish()\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.act(x + self.block(x))"
      ],
