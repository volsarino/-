        "class MLP(nn.Module):\n",
        "    def __init__(self,num_inputs, hidden_dim=256,dropout=0.1, num_outputs=1):\n",
        "        super().__init__()\n",
        "        self.in_proj = nn.Sequential(\n",
        "            nn.Linear(num_inputs, hidden_dim),\n",
        "            nn.BatchNorm1d(hidden_dim),\n",
        "            nn.Mish(),\n",
        "        )\n",
        "\n",
        "        #残差ブロック\n",
        "        self.block1 = ResBlock(hidden_dim, dropout)\n",
        "        self.block2 = ResBlock(hidden_dim, dropout)\n",
        "\n",
        "        #出力層\n",
        "        self.out_proj = nn.Sequential(\n",
        "            nn.Linear(hidden_dim, hidden_dim // 2),\n",
        "            nn.Mish(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(hidden_dim // 2, num_outputs),\n",
        "        )\n",
        "\n",
        "    def forward(self,x):\n",
        "        x = self.in_proj(x)\n",
        "        x = self.block1(x)  #残差結合1\n",
        "        x = self.block2(x)  #残差結合2\n",
        "        return self.out_proj(x)"
      ],
